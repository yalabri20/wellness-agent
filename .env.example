# Demo / runtime
DEMO_MODE=true
DEMO_CLOCK=
DATABASE_URL=sqlite:///./wellness.db
API_BASE_URL=http://127.0.0.1:8000
API_LATENCY_MS=50
API_FAILURE_RATE=0.0
QUIET_HOURS_START=18:00
QUIET_HOURS_END=08:00
WORK_HOURS_START=08:00
WORK_HOURS_END=16:00
MAX_PROACTIVE_PER_DAY=3
K_ANONYMITY=5
LLM_TIMEOUT_SECONDS=8

# LLM provider: anthropic | openai | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Walk / Apple Shortcut shared secret (POST /activity/steps)
ACTIVITY_API_TOKEN=wellness-demo-steps

# Slack (optional — simulator works without these)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
LIVE_DEMO_SLACK_USER_ID=

# Streamlit
SIMULATOR_PORT=8501
DASHBOARD_PORT=8502
